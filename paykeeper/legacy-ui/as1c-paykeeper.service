[Unit]
Description=AS1C PayKeeper isolated connection console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ilyas
Group=ilyas
WorkingDirectory=/home/ilyas/as1c/paykeeper-integration
ExecStart=/usr/bin/python3 -B /home/ilyas/as1c/paykeeper-integration/app.py
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ilyas/as1c/paykeeper-integration/state
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=50

[Install]
WantedBy=multi-user.target
