#!/usr/bin/env python3
import json
import os
import pwd
import subprocess
import sys
from pathlib import Path

USER = os.environ["AS1C_OS_USER"]
ACCOUNT = os.environ["AS1C_SCHOOL_EMAIL"]
SCRIPT_ID = os.environ["AS1C_AVT2_SCRIPT_ID"]
WORKSPACE = Path(os.environ["AS1C_AVT2_WORKSPACE"])
AUTH_FILE = Path(os.environ["AS1C_OAUTH_FILE"])
CLASP = os.environ["AS1C_CLASP_COMMAND"]

def deny(reason):
    print("DENIED: " + reason, file=sys.stderr)
    raise SystemExit(1)

if len(sys.argv) != 2 or sys.argv[1] not in ("verify", "refresh"):
    deny("only verify or refresh is allowed")
if pwd.getpwuid(os.geteuid()).pw_name != USER:
    deny("wrong Linux owner")

for directory in (WORKSPACE.parent.parent, WORKSPACE.parent, WORKSPACE, AUTH_FILE.parent):
    if directory.is_symlink() or not directory.is_dir():
        deny("invalid workspace or authentication directory")
    mode = directory.stat()
    if mode.st_uid != os.geteuid() or mode.st_mode & 0o077:
        deny("directory not private")
for file in (AUTH_FILE, WORKSPACE / ".clasp.json"):
    if file.is_symlink() or not file.is_file():
        deny("missing credential or project file")
    mode = file.stat()
    if mode.st_uid != os.geteuid() or mode.st_mode & 0o077:
        deny("file not private")

config = json.loads((WORKSPACE / ".clasp.json").read_text())
if config.get("scriptId") != SCRIPT_ID or config.get("rootDir", "") != "":
    deny("unexpected script ID or root directory")

base = [CLASP, "--auth", str(AUTH_FILE), "--user", "avtoshkola"]
verification = subprocess.run(base + ["--json", "show-authorized-user"],
                              cwd=WORKSPACE, text=True, capture_output=True, timeout=45)
if verification.returncode:
    deny("Google authorization check failed")
try:
    profile = json.loads(verification.stdout)
except ValueError:
    deny("invalid Google authorization status")
if not profile.get("loggedIn") or profile.get("email", "").lower() != ACCOUNT:
    deny("Google account mismatch")

if sys.argv[1] == "refresh":
    os.umask(0o077)
    subprocess.run(base + ["pull"], cwd=WORKSPACE, check=True, timeout=90)
    for item in WORKSPACE.iterdir():
        if item.is_symlink():
            deny("unexpected symlink in workspace")
        if item.is_file() and item.stat().st_mode & 0o077:
            deny("downloaded file not private")
print("VERIFIED_READ_ONLY " + ACCOUNT + " " + SCRIPT_ID)
