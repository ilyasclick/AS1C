#!/usr/bin/env python3
import json
import os
import pwd
import subprocess
import sys
from pathlib import Path

PROFILES = {
    os.environ["AS1C_OS_USER"]: {
        "lyasikme": os.environ["AS1C_PERSONAL_EMAIL"],
        "avtoshkola": os.environ["AS1C_SCHOOL_EMAIL"],
    },
}
CLASP = os.environ["AS1C_CLASP_COMMAND"]
AUTH_ROOT = Path(os.environ["AS1C_AUTH_ROOT"])

def refuse(message):
    print("DENIED: " + message, file=sys.stderr)
    raise SystemExit(1)

def main():
    os.umask(0o077)
    if len(sys.argv) != 3:
        refuse("usage: python3 as1c-clasp <alias> <login|status|list>")
    alias, action = sys.argv[1:]
    username = pwd.getpwuid(os.geteuid()).pw_name
    accounts = PROFILES.get(username, {})
    if alias not in accounts or action not in ("login", "status", "list"):
        refuse("unapproved user, account, or action")
    workspace_root = Path(pwd.getpwnam(username).pw_dir) / "apps-script"
    workspace = workspace_root / alias
    auth_dir = AUTH_ROOT / username
    for directory in (workspace_root, workspace, auth_dir):
        if directory.is_symlink():
            refuse("symlinked directory")
        st = directory.stat()
        if st.st_uid != os.geteuid() or st.st_mode & 0o077:
            refuse("workspace or auth path is not private")
    auth_file = auth_dir / ".clasprc.json"
    if auth_file.exists() or auth_file.is_symlink():
        if auth_file.is_symlink():
            refuse("credential symlink")
        st = auth_file.stat()
        if st.st_uid != os.geteuid() or st.st_mode & 0o077:
            refuse("credential file is not private")
    base = [CLASP, "--auth", str(auth_file), "--user", alias]
    if action == "login":
        print("Authorize only " + accounts[alias] + " in your own SSH terminal.")
        sys.stdout.flush()
        os.chdir(workspace)
        os.execv(CLASP, base + ["login", "--no-localhost"])
    verify = subprocess.run(
        base + ["--json", "show-authorized-user"],
        cwd=workspace, capture_output=True, text=True, timeout=45,
    )
    if verify.returncode:
        refuse("authorization verification failed")
    try:
        profile = json.loads(verify.stdout)
    except ValueError:
        refuse("authorization status is not JSON")
    if not profile.get("loggedIn"):
        refuse("not logged in")
    if profile.get("email", "").lower() != accounts[alias].lower():
        refuse("Google account does not match the approved alias")
    if action == "status":
        print("AUTHORIZED " + alias + ": " + profile["email"])
    elif action == "list":
        result = subprocess.run(base + ["list-scripts"], cwd=workspace, timeout=90)
        raise SystemExit(result.returncode)

if __name__ == "__main__":
    main()
